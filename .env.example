# ── Required ────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
MODEL_NAME=openai/gpt-oss-120b

# ── Only needed for agent mode (python app.py) ──────────────────────────────
EMAIL=your_gmail@gmail.com
APP_PASSWORD=your_16_char_app_password
RECIPIENTS=email1@gmail.com,email2@gmail.com

# ── REST API (api.py) ───────────────────────────────────────────────────────
# Required for POST /ingest-news and DELETE /knowledge-base. Use a long random
# value, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
